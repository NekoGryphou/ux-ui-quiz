{
  "name": "kanom-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "svelte-check && eslint . && stylelint \"src/**/*.{scss,css,svelte}\" && knip && prettier --check . && vitest run && node scripts/validate-quizzes.ts && vite build",
    "check": "svelte-check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/**/*.ts --coverage.exclude=src/**/tests/** --coverage.exclude=src/quizzes/meta/**",
    "e2e": "playwright test",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:quizzes": "node scripts/validate-quizzes.ts",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.{scss,css,svelte}\"",
    "knip": "knip"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.40.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.94.0",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.8",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@fontsource/anek-latin": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/mulish": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "shiki": "^4.5.0"
  }
}
